# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不要提交真实密钥。
# 全部环境变量的权威列表见 docs/configuration.md。

TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 账号凭据的 AES-256-GCM 主密钥（32 字节，写成 base64 或 64 位 hex）。
#
#   生成：openssl rand -base64 32
#
# 留空也能跑：服务端首次启动会自己生成一把写到数据目录的 .encryption-key（权限 600）。
# 但请务必搞清楚这件事——
#   丢了这把钥匙 = 所有邮箱账号的 refresh_token 与密码永久无法解密，只能逐个重新授权。
# 换机器时数据目录要整个带走，或者干脆在这里自己填一把，密钥归属从一开始就明确。
# ---------------------------------------------------------------------------
FIREMAIL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 下面都是可选项，不填就用默认值。
#
# 注意：Compose 的 .env 只做「变量替换」，不会自动把变量注入容器。
# 目前 docker-compose.yml 只引用了 TZ 和 FIREMAIL_ENCRYPTION_KEY，
# 想让下面这些也生效，给 firemail 服务加一行：
#
#     env_file: .env
#
# 或者把要用的那一项写进 docker-compose.yml 的 environment: 块。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 三层同步
#
#   1. 后台基线   7×24，**串行**（一次一个账号），保证你打开界面时该收的信已经在了；
#   2. 批量同步   你点「全部同步」时，暂停后台基线、按下面的并发上限并行跑；
#   3. 单账号同步 你对某个账号点「立即同步」，优先级最高。
#
# 三层共用同一套重试语义：失败就退避重试，每个账号每轮最多 3 次；
# 中途失败不会显示成失败，只有一轮真的用完次数才会标记账号。
# ---------------------------------------------------------------------------

# **用户发起的**同步（第 2、3 层）的并发上限（1-32）。每个账号占一条 IMAP 连接。
# 后台基线按定义是串行的，不受这一项影响。
# 默认 2 来自生产 A/B（29 个 Outlook 账号、5 分钟一轮）：
#   并发 4 → 同步失败率 17.7%（n=62，波及 8 个账号）
#   并发 2 → 3.0%（n=66，2 个账号）；部署后在 2 上复测 → 2.2%（n=45，0 个账号）
# FIREMAIL_SYNC_CONCURRENCY=2

# 周期同步总开关。关掉后只能手动触发同步。
# FIREMAIL_SYNC_SCHEDULER=true

# 每个账号每轮的尝试次数（含首次，1-5）。
# FIREMAIL_SYNC_MAX_ATTEMPTS=3

# 后台基线里两个账号之间的间隔（毫秒，0-60000）。
# 29 个账号串行一圈约 29 × (6.6 + 2) ≈ 250 秒，仍装得进 300 秒的同步周期。
# FIREMAIL_SYNC_GAP_MS=2000

# 后台基线中单个账号一轮的总时间预算（毫秒，5000-600000），覆盖它的全部尝试与退避。
# 串行意味着慢账号会挡住后面的每一个，超预算就记为失败并立刻让位。
# 90 秒明显高于实测最慢的一次成功同步（46.7 秒），不会误杀只是慢的账号。
# FIREMAIL_SYNC_ACCOUNT_BUDGET_MS=90000

# 连续失败多少轮之后判定「该停掉这个账号了」（2-100）。
# 一轮 = 用完全部尝试仍然失败。生产上凭据完全正常却连续失败的最长记录是 6 轮 / 26 分钟。
# FIREMAIL_SYNC_SUSPEND_AFTER_ROUNDS=8

# 上面的判定要不要真的执行。默认 false = 只记录不暂停，日志里能看到「本来会暂停谁」。
# 等真实数据说明门槛合适了再打开。
# FIREMAIL_SYNC_SUSPEND_ENFORCE=false

# 单个附件上传上限，单位 MB（1-200）。
# FIREMAIL_MAX_UPLOAD_MB=25

# 日志级别：fatal / error / warn / info / debug / trace / silent
# LOG_LEVEL=info

# 放在反向代理后面时打开，让限流按真实客户端 IP 计数。
# 直接暴露端口时**不要**开，否则客户端可以伪造 X-Forwarded-For。
# FIREMAIL_TRUST_PROXY=false

# 跨源白名单，逗号分隔，必须带协议。不接受 "*"（本服务用 cookie 认证）。
# 同源部署时留空。本地开发用 vite 代理时需要放行 http://localhost:5173。
# FIREMAIL_CORS_ORIGINS=
